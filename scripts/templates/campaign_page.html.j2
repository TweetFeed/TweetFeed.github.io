<!DOCTYPE html>
<html lang="en">

<head>
	<!-- 100% privacy-first analytics -->
	<script defer src="https://cloud.umami.is/script.js" data-website-id="37841dcd-5b99-4fb8-8dc8-4d40f4d38d86" data-domains="tweetfeed.live"></script>
	<!-- Umami self-hosted (own infra), running alongside Umami Cloud above for a ~30-day comparison before Cloud is retired -->
	<script defer src="https://s.tweetfeed.live/script.js" data-website-id="d81a4278-e114-4627-a06d-d3c5178f4950" data-domains="tweetfeed.live"></script>
	<!-- Ahrefs Web Analytics (cookieless) -->
	<script src="https://analytics.ahrefs.com/analytics.js" data-key="J59c6Ehci39jQWCQRIWuRw" async></script>
	<link rel="icon" href="../../favicon.ico" type="image/x-icon">
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	{%- if noindex %}
	<meta name="robots" content="noindex, nofollow">
	{%- endif %}
	<meta name="description" content="{{ c.meta_description }}">
	<meta name="author" content="tweetfeed.live">
	<link rel="canonical" href="https://tweetfeed.live/campaigns/{{ c.id }}/">
	<title>{{ c.title }} | TweetFeed</title>
	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ c.title }}">
	<meta name="twitter:description" content="{{ c.meta_description }}">
	<meta name="twitter:url" content="https://tweetfeed.live/campaigns/{{ c.id }}/">
	<meta name="twitter:image" content="https://tweetfeed.live/img/TweetFeed_card_og.png">
	<meta name="twitter:creator" content="@0xDanielLopez">
	<!-- Facebook -->
	<meta property="og:url" content="https://tweetfeed.live/campaigns/{{ c.id }}/">
	<meta property="og:type" content="website">
	<meta property="og:title" content="{{ c.title }}">
	<meta property="og:description" content="{{ c.meta_description }}">
	<meta property="og:site_name" content="tweetfeed.live">
	<meta property="og:image" content="https://tweetfeed.live/img/TweetFeed_card_og.png">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="627">
	<meta property="og:image:type" content="image/png">
	<meta property="og:image:alt" content="TweetFeed logo">
	<!-- Preconnect -->
	<link rel="preconnect" href="//fonts.googleapis.com">
	<!-- Custom fonts for this template -->
	<link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" as="style" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></noscript>
	<!-- Custom styles for this template -->
	<link href="../../css/sb-admin-2.min.css" rel="stylesheet">
	<!-- Custom CSS 0xDanielLopez -->
	<link href="../../css/table.css?v=4" rel="stylesheet">
	<link href="../../css/index.css?v=51" rel="stylesheet">
	<link href="../../css/tweetfeed.css?v=51" rel="stylesheet">
	<link rel="preload" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC&display=swap" rel="stylesheet"></noscript>
	<link rel="preload" href="https://fonts.googleapis.com/css2?family=Rubik&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Rubik&display=swap" rel="stylesheet"></noscript>
	<!-- Structured data -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "TweetFeed",
		"url": "https://tweetfeed.live/",
		"logo": "https://tweetfeed.live/img/TweetFeed_card_og.png",
		"@id": "https://tweetfeed.live/#organization",
		"founder": {"@id": "https://tweetfeed.live/#founder"},
		"sameAs": [
			"https://github.com/0xDanielLopez/TweetFeed",
			"https://phishunt.io/",
			"https://daniel.tools/"
		]
	}
	</script>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"@id": "https://tweetfeed.live/#founder",
		"name": "Daniel López",
		"url": "https://tweetfeed.live/about/",
		"image": "https://tweetfeed.live/img/TweetFeed_card_og.png",
		"jobTitle": "Cyber Threat Researcher",
		"description": "Cyber threat researcher with 10+ years in cybersecurity. Founder of TweetFeed and phishunt.io; maintainer of public Threat Intelligence feeds and MCP servers for AI agents.",
		"founderOf": {"@id": "https://tweetfeed.live/#organization"},
		"sameAs": [
			"https://github.com/0xDanielLopez",
			"https://x.com/0xDanielLopez",
			"https://daniel.tools/",
			"https://phishunt.io/",
			"https://0xdaniellopez.github.io/CV/"
		]
	}
	</script>
	<script type="application/ld+json">
	{{ webpage_jsonld | safe }}
	</script>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://tweetfeed.live/"},
			{"@type": "ListItem", "position": 2, "name": "Campaigns", "item": "https://tweetfeed.live/campaigns/"},
			{"@type": "ListItem", "position": 3, "name": "{{ c.title }}", "item": "https://tweetfeed.live/campaigns/{{ c.id }}/"}
		]
	}
	</script>
</head>

<body id="page-top">
	<a class="skip-link" href="#content">Skip to content</a>
	<style>
		.skip-link {
			position: absolute;
			top: -40px;
			left: 0;
			background: #000;
			color: #fff;
			padding: 8px 16px;
			z-index: 10000;
			text-decoration: none;
			font-family: 'Rubik', sans-serif;
			font-size: 14px;
			border-radius: 0 0 4px 0;
		}
		.skip-link:focus {
			top: 0;
			outline: 2px solid #3a6f96;
			outline-offset: -2px;
		}
		/* The desktop navbar is fixed-top at 56px and nothing compensates for
		   it, so every anchor on this campaign_page.html.j2 page used to land
		   underneath it. Same fix as feeds/index.html. */
		@media (min-width: 992px) {
			#content [id]:target,
			#content h2[id], #content h3[id], #content section[id] { scroll-margin-top: 72px; }
		}
	</style>
	<!-- Page Wrapper -->
	<div id="wrapper">
		<!-- Content Wrapper -->
		<div id="content-wrapper" class="d-flex flex-column">
{{ shell_nav }}
			<div id="content" tabindex="-1">
			<div class="docs-wrap">
{{ shell_docs_sidebar }}
							<main class="docs-content">
				<div id="presentationSecondary" class="d-none d-md-block">
					<br><br><br>
					<h1 class="toph1"><i class="fas fa-layer-group" style="font-size: 36px;"></i> {{ c.title }}</h1>
					<p style="font-size:14px;color:#737373;margin-top:0.5rem;">Snapshot generated {{ c.generated_at_str }}. AI-clustered from public Twitter/X threat-intel reports.</p>
				</div>
				<div id="presentationMobile" class="d-block d-md-none">
					<br>
					<p class="toph1" role="heading" aria-level="1"><i class="fas fa-layer-group" style="font-size: 36px;"></i> {{ c.title }}</p>
					<p style="font-size:13px;color:#737373;margin-top:0.25rem;">Snapshot generated {{ c.generated_at_str }}.</p>
				</div>
				<hr class="divider"> <!-- DIVIDER -->

				<!-- ============================================================ -->
				<!-- IOCS BY WINDOW (BAKED, NOT LIVE)                              -->
				<!-- ============================================================ -->
				<h2 class="section-heading tf-block-head">Campaign stats</h2>
				<div class="row">
					<div class="col-md-4 col-sm-6 col-12">
						<div class="card shadow mb-4">
							<div class="card-header text-center">
								<span class="card-text cardTitle">IOCs</span>
								<hr>
								<p style="font-size: 32px; font-weight: 600; color: #0026E6; margin-bottom: 0.25rem; font-family: 'Rubik', sans-serif;">{{ c.ioc_count }}</p>
								<p style="font-size: 13px; color: #737373; margin-bottom: 0;">tracked in this campaign</p>
							</div>
						</div>
					</div>
					<div class="col-md-4 col-sm-6 col-12">
						<div class="card shadow mb-4">
							<div class="card-header text-center">
								<span class="card-text cardTitle">Confidence</span>
								<hr>
								<p style="font-size: 32px; font-weight: 600; color: #0026E6; margin-bottom: 0.25rem; font-family: 'Rubik', sans-serif; text-transform:capitalize;">{{ c.confidence }}</p>
								<p style="font-size: 13px; color: #737373; margin-bottom: 0;">clustering confidence</p>
							</div>
						</div>
					</div>
					<div class="col-md-4 col-sm-6 col-12">
						<div class="card shadow mb-4">
							<div class="card-header text-center">
								<span class="card-text cardTitle">First seen</span>
								<hr>
								<p style="font-size: 28px; font-weight: 600; color: #0026E6; margin-bottom: 0.25rem; font-family: 'Rubik', sans-serif;">{{ c.first_seen }}</p>
								<p style="font-size: 13px; color: #737373; margin-bottom: 0;">earliest IOC in this cluster</p>
							</div>
						</div>
					</div>
				</div>
				<p style="color:#737373; font-size:13px; font-family:'Rubik',sans-serif; margin-top:-0.5rem; margin-bottom:1.5rem;">Snapshot as of {{ c.generated_at_str }}. This is a manually-generated prototype page, not yet on the daily regeneration cycle.</p>

				<!-- ============================================================ -->
				<!-- ABOUT THIS TAG                                                -->
				<!-- ============================================================ -->
				<h2 class="section-heading tf-block-head">About this campaign</h2>
				<div class="card mb-4">
					<div class="card-body">
						<p style="margin-bottom:0; font-family:'Rubik',sans-serif; color:#1c1c1c; font-size:15px; line-height:1.8;">{{ c.context_html }}</p>
					</div>
				</div>

				<!-- ============================================================ -->
				<!-- DOMAINS IN THIS CAMPAIGN                                      -->
				<!-- ============================================================ -->
				<h2 class="section-heading tf-block-head">Domains in this campaign</h2>
				<div class="card mb-4">
					<div class="card-body">
						{% if c.domains %}
						<div class="table-responsive">
							<table class="table table-sm" style="table-layout:fixed; width:100%; min-width:320px; margin-bottom:0;">
								<colgroup><col style="width:100%;"></colgroup>
								<thead><tr><th scope="col">Domain</th></tr></thead>
								<tbody>
									{% for d in c.domains %}<tr>
										<td style="font-family:'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; font-size:13px; vertical-align:middle;" title="{{ d.value_full }}"><i class="tf-copy far fa-copy" data-copy="{{ d.value_full }}" style="margin-right:0.4rem;" role="button" tabindex="0" aria-label="Copy IOC value" title="Copy"></i>{{ d.value_display }}</td>
									</tr>
									{% endfor %}</tbody>
							</table>
						</div>
						{% else %}
						<p style="margin-bottom:0; color:#737373; font-size:14px; font-family:'Rubik',sans-serif;">No registered-domain anchors for this campaign (clustered on tags or URL path patterns instead).</p>
						{% endif %}
					</div>
				</div>

				<!-- ============================================================ -->
				<!-- INFRASTRUCTURE FOOTPRINT (IP-TYPE IOCS, IPMETA.JSON LOOKUP)   -->
				<!-- Omitted entirely when the campaign has no matched IP infra   -->
				<!-- (majority case - most campaigns are domain/URL-heavy).       -->
				<!-- ============================================================ -->
				{% if c.infra %}
				<h2 class="section-heading tf-block-head">Infrastructure footprint</h2>
				<div class="card mb-4">
					<div class="card-body">
						<p style="margin-bottom:0.75rem; color:#737373; font-size:14px; font-family:'Rubik',sans-serif;">{{ c.infra_ip_count }} IP{{ 's' if c.infra_ip_count != 1 }} across {{ c.infra_org_count }} network{{ 's' if c.infra_org_count != 1 }} in this campaign:</p>
						<div class="table-responsive">
							<table class="table table-sm" style="table-layout:fixed; width:100%; min-width:420px; margin-bottom:0;">
								<colgroup>
									<col style="width:100%;">
									<col style="width:70px;">
									<col style="width:90px;">
								</colgroup>
								<thead>
									<tr>
										<th scope="col">Network</th>
										<th scope="col">IPs</th>
										<th scope="col">Country</th>
									</tr>
								</thead>
								<tbody>
									{% for i in c.infra %}<tr>
										<td style="font-family:'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; font-size:13px; vertical-align:middle; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ i.org }}">{{ i.org }}</td>
										<td style="font-size:13px; vertical-align:middle;">{{ i.ip_count }}</td>
										<td style="font-size:13px; vertical-align:middle;">{{ i.country }}</td>
									</tr>
									{% endfor %}</tbody>
							</table>
						</div>
					</div>
				</div>
				{% endif %}

				<!-- ============================================================ -->
				<!-- IOCS IN THIS CAMPAIGN (BAKED FROM API AT BUILD TIME)          -->
				<!-- ============================================================ -->
				<h2 class="section-heading tf-block-head">IOCs in this campaign</h2>
				<div class="card mb-4">
					<div class="card-body">
						{% if iocs %}
						<p style="margin-bottom:0.75rem; color:#737373; font-size:14px; font-family:'Rubik',sans-serif;">Showing up to 25 IOCs (the campaigns API caps each campaign's published list at 25). Live JSON: <a href="https://api.tweetfeed.live/v1/campaigns" target="_blank" rel="noopener noreferrer"><code>api.tweetfeed.live/v1/campaigns</code></a>.</p>
						<div class="table-responsive">
							<table class="table table-sm" style="table-layout:fixed; width:100%; min-width:720px; margin-bottom:0;">
								<colgroup>
									<col style="width:90px;">
									<col style="width:60px;">
									<col style="width:100%;">
									<col style="width:100px;">
								</colgroup>
								<thead>
									<tr>
										<th scope="col">Date</th>
										<th scope="col">Type</th>
										<th scope="col">Value</th>
										<th scope="col">Source</th>
									</tr>
								</thead>
								<tbody>
									{% for s in iocs %}<tr>
										<td style="font-size:12px; color:#737373; vertical-align:middle; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ s.date_short }}</td>
										<td style="vertical-align:middle;"><span style="font-size:11px; padding:2px 6px; background:{{ s.type_color }}; color:{{ s.type_text_color }}; border-radius:3px;">{{ s.type }}</span></td>
										<td style="font-family:'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; font-size:13px; vertical-align:middle; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ s.value_full }}"><i class="tf-copy far fa-copy" data-copy="{{ s.value_full }}" style="margin-right:0.4rem;" role="button" tabindex="0" aria-label="Copy IOC value" title="Copy"></i>{{ s.value_display }}</td>
										<td style="font-size:12px; vertical-align:middle; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><a href="https://x.com/{{ s.user }}" target="_blank" rel="noopener noreferrer">@{{ s.user }}</a></td>
									</tr>
									{% endfor %}</tbody>
							</table>
						</div>
						{% else %}
						<p style="margin-bottom:0; color:#737373; font-size:14px; font-family:'Rubik',sans-serif;">No IOC rows available for this campaign.</p>
						{% endif %}
					</div>
				</div>

				<!-- ============================================================ -->
				<!-- EXPLORE MORE                                                  -->
				<!-- ============================================================ -->
				<h2 class="section-heading tf-block-head">Explore more</h2>
				<div class="card mb-4">
					<div class="card-body">
						<p style="color:#737373; font-size:14px; font-family:'Rubik',sans-serif; margin-bottom:0;">See all active campaigns on the <a href="../../campaigns/" class="text-decoration-none">Campaigns</a> page, or browse the full <a href="../../feeds/" class="text-decoration-none">IOC feed</a>.</p>
					</div>
				</div>

				<!-- ============================================================ -->
				<!-- LICENSE                                                       -->
				<!-- ============================================================ -->
				<h2 class="section-heading tf-block-head">License</h2>
				<p style="color: #737373;font-size: 16px;font-family: 'Rubik', sans-serif;">
					This campaign's IOC data: <b>CC0 1.0 Public Domain</b>. No attribution required, no warranty. Campaign descriptions are AI-generated from the underlying IOC data and may contain errors - verify before acting on them. Source code for the pipeline:
					<a target="_blank" rel="noopener noreferrer" href="https://github.com/0xDanielLopez/TweetFeed">github.com/0xDanielLopez/TweetFeed</a> (MIT).
				</p>

			</main>
			<!-- End of Main Content -->

			</div>
			</div>
{{ shell_footer }}
		</div>
		<!-- End of Content Wrapper -->
	</div>
	<!-- End of Page Wrapper -->

	<!-- Bootstrap core JavaScript-->
	<script src="../../vendor/jquery/jquery.min.js"></script>
	<script src="../../vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
	<!-- TweetFeed shared utilities (delegated tf-copy click handler) -->
	<script src="../../js/utils.js?v=4"></script>
	<script>
	$(function() { $('[data-toggle="tooltip"]').tooltip() });
	</script>
</body>

</html>
