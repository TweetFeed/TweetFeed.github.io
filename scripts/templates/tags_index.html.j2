<!DOCTYPE html>
<html lang="en">

<head>
	<!-- 100% privacy-first analytics -->
	<!-- Umami, self-hosted on our own infrastructure. Cookieless, no localStorage, no personal data stored. -->
	<script defer src="https://s.tweetfeed.live/script.js" data-website-id="d81a4278-e114-4627-a06d-d3c5178f4950" data-domains="tweetfeed.live"></script>
	<!-- Ahrefs Web Analytics (cookieless) -->
	<script src="https://analytics.ahrefs.com/analytics.js" data-key="J59c6Ehci39jQWCQRIWuRw" async></script>
	<link rel="icon" href="../favicon.ico" type="image/x-icon">
	<link rel="apple-touch-icon" sizes="180x180" href="../apple-touch-icon.png">
	<meta name="apple-mobile-web-app-title" content="TweetFeed">
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
{{ shell_theme_init }}
	{%- if noindex %}
	<meta name="robots" content="noindex, nofollow">
	{%- endif %}
	<meta name="description" content="Index of all {{ tag_count }} tag landing pages on TweetFeed - APT groups, malware families, TTPs and vulnerabilities. Each tag links to its IOC stream and curated reference content.">
	<meta name="author" content="tweetfeed.live">
	<meta name="keywords" content="tweetfeed tags,malware family tags,apt group tags,ttp tags,ioc taxonomy,tag index">
	<link rel="canonical" href="https://tweetfeed.live/tags/">
	<link rel="alternate" type="application/rss+xml" title="TweetFeed - all IOCs" href="https://tweetfeed.live/rss.xml">
	<title>Tag index - TweetFeed</title>
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="Tag index - TweetFeed">
	<meta name="twitter:description" content="Index of all {{ tag_count }} tag landing pages: APT groups, malware families, TTPs and vulnerabilities.">
	<meta name="twitter:url" content="https://tweetfeed.live/tags/">
	<meta name="twitter:image" content="https://tweetfeed.live/img/TweetFeed_card_og.png">
	<meta name="twitter:creator" content="@0xDanielLopez">
	<meta property="og:url" content="https://tweetfeed.live/tags/">
	<meta property="og:type" content="website">
	<meta property="og:title" content="Tag index - TweetFeed">
	<meta property="og:description" content="Index of all {{ tag_count }} tag landing pages: APT groups, malware families, TTPs and vulnerabilities.">
	<meta property="og:site_name" content="tweetfeed.live">
	<meta property="og:image" content="https://tweetfeed.live/img/TweetFeed_card_og.png">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="627">
	<meta property="og:image:type" content="image/png">
	<meta property="og:image:alt" content="TweetFeed - tag index">
	<link rel="preload" href="../fonts/alegreya-sans-sc-latin.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="../fonts/rubik-latin.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="../vendor/fontawesome/css/all.min.css?v=1" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="../vendor/fontawesome/css/all.min.css?v=1" rel="stylesheet"></noscript>
	<link href="../css/sb-admin-2.min.css" rel="stylesheet">
	<link href="../css/index.min.css?v=77" rel="stylesheet">
	<link href="../css/tweetfeed.min.css?v=77" rel="stylesheet">
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "TweetFeed",
		"url": "https://tweetfeed.live/",
		"logo": "https://tweetfeed.live/img/TweetFeed_card_og.png",
		"@id": "https://tweetfeed.live/#organization",
		"founder": {"@id": "https://tweetfeed.live/#founder"},
		"sameAs": [
			"https://github.com/0xDanielLopez/TweetFeed",
			"https://phishunt.io/",
			"https://daniel.tools/"
		]
	}
	</script>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": "Tag index",
		"url": "https://tweetfeed.live/tags/",
		"description": "Index of all {{ tag_count }} tag landing pages on TweetFeed.",
		"isPartOf": {"@id": "https://tweetfeed.live/#organization"},
		"inLanguage": "en",
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": {{ tag_count }},
			"itemListOrder": "https://schema.org/ItemListOrderAscending",
			"itemListElement": [{% for t in tags_flat %}
				{"@type": "ListItem", "position": {{ loop.index }}, "name": "#{{ t.display_tag }}", "url": "https://tweetfeed.live/tag/{{ t.slug }}/"}{% if not loop.last %},{% endif %}{% endfor %}
			]
		}
	}
	</script>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://tweetfeed.live/"},
			{"@type": "ListItem", "position": 2, "name": "Tag index", "item": "https://tweetfeed.live/tags/"}
		]
	}
	</script>
	<style>
		@media (max-width: 575.98px) {
			.tf-tile-head { flex-direction: column; align-items: flex-start !important; }
		}
	</style>
</head>

<body id="page-top">
	<a class="skip-link" href="#content">Skip to content</a>
	<div id="wrapper">
		<div id="content-wrapper" class="d-flex flex-column">
{{ shell_nav }}
			<div id="content" tabindex="-1">
			<div class="docs-wrap">
{{ shell_docs_sidebar }}
				<main class="docs-content">
				<div id="presentationSecondary" class="d-none d-md-block">
					<br><br><br>
					<h1 class="toph1"><i class="fas fa-tags" style="font-size: 36px;"></i> Tag index</h1>
					<h2><em>{{ tag_count }} curated tag landing pages: APT groups, malware families, TTPs and vulnerabilities</em></h2>
				</div>
				<div id="presentationMobile" class="d-block d-md-none">
					<br>
					<p class="toph1" role="heading" aria-level="1"><i class="fas fa-tags" style="font-size: 36px;"></i> Tag index</p>
					<p style="font-size: 14px;"><em>{{ tag_count }} curated tag landing pages</em></p>
				</div>
				<hr class="divider">

				{% for cat in categories %}
				<h3 class="section-heading tf-block-head">{{ cat.heading }} <span style="font-size:14px; color:var(--tf-fg-737373); font-weight:400;">&middot; {{ cat.tags | length }}</span></h3>
				<div class="card mb-4">
					<div class="card-body">
						<p style="margin-bottom:0.9rem; color:var(--tf-fg-737373); font-size:14px; font-family:'Rubik',sans-serif;">{{ cat.blurb }}</p>
						<div class="row">
							{% for t in cat.tags %}
							<div class="col-md-6 col-12" style="margin-bottom:0.7rem;">
								<a href="../tag/{{ t.slug }}/" class="text-decoration-none" style="display:block; padding:0.5rem 0.7rem; border:1px solid var(--tf-bd-1c1c1c); border-radius:0; background:var(--tf-bg-fff);">
									<div class="tf-tile-head" style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:0.6rem; row-gap:0;">
										<span style="font-family:'Rubik',sans-serif; font-weight:600; color:var(--tf-fg-1c1c1c);">#{{ t.display_tag }}</span>
										<span style="font-size:11px; color:var(--tf-fg-737373); font-family:'Rubik',sans-serif; white-space:nowrap;">{{ t.year_count }} hits last year &middot; {{ t.month_count }} last month</span>
									</div>
									<div style="font-size:12px; color:var(--tf-fg-737373); font-family:'Rubik',sans-serif; line-height:1.4; margin-top:0.15rem;">{{ t.subtitle }}</div>
								</a>
							</div>
							{% endfor %}
						</div>
					</div>
				</div>
				{% endfor %}

				<h3 class="section-heading tf-block-head">Other reference</h3>
				<div class="card mb-4">
					<div class="card-body">
						<p style="margin-bottom:0; color:var(--tf-fg-1c1c1c); font-size:15px; font-family:'Rubik',sans-serif; line-height:1.7;">
							<a href="../ioc-types/" class="text-decoration-none"><b>IOC types</b></a> &middot; the 5 type-specific hubs (URLs / domains / IPs / MD5 / SHA-256). <br>
							<a href="../threat-intelligence-guide/" class="text-decoration-none"><b>Threat Intelligence guide</b></a> &middot; ~1,640-word pillar covering IOC types, OSINT vs commercial, MITRE ATT&amp;CK basics, glossary.
						</p>
					</div>
				</div>
				</main>

			</div>
			</div>
{{ shell_footer }}
		</div>
	</div>
	<script defer src="../vendor/jquery/jquery.min.js"></script>
	<script defer src="../vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script defer src="../js/utils.js?v=10"></script>
</body>

</html>
