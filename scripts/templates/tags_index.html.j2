<!DOCTYPE html>
<html lang="en">

<head>
	<!-- 100% privacy-first analytics -->
	<script defer src="https://cloud.umami.is/script.js" data-website-id="37841dcd-5b99-4fb8-8dc8-4d40f4d38d86" data-domains="tweetfeed.live"></script>
	<!-- Umami self-hosted (own infra), running alongside Umami Cloud above for a ~30-day comparison before Cloud is retired -->
	<script defer src="https://s.tweetfeed.live/script.js" data-website-id="d81a4278-e114-4627-a06d-d3c5178f4950" data-domains="tweetfeed.live"></script>
	<!-- Ahrefs Web Analytics (cookieless) -->
	<script src="https://analytics.ahrefs.com/analytics.js" data-key="J59c6Ehci39jQWCQRIWuRw" async></script>
	<link rel="icon" href="../favicon.ico" type="image/x-icon">
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	{%- if noindex %}
	<meta name="robots" content="noindex, nofollow">
	{%- endif %}
	<meta name="description" content="Index of all {{ tag_count }} tag landing pages on TweetFeed - APT groups, malware families and TTPs. Each tag links to its IOC stream and curated reference content.">
	<meta name="author" content="tweetfeed.live">
	<meta name="keywords" content="tweetfeed tags,malware family tags,apt group tags,ttp tags,ioc taxonomy,tag index">
	<link rel="canonical" href="https://tweetfeed.live/tags/">
	<title>Tag index - TweetFeed</title>
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="Tag index - TweetFeed">
	<meta name="twitter:description" content="Index of all {{ tag_count }} tag landing pages: APT groups, malware families and TTPs.">
	<meta name="twitter:url" content="https://tweetfeed.live/tags/">
	<meta name="twitter:image" content="https://tweetfeed.live/img/TweetFeed_card_og.png">
	<meta name="twitter:creator" content="@0xDanielLopez">
	<meta property="og:url" content="https://tweetfeed.live/tags/">
	<meta property="og:type" content="website">
	<meta property="og:title" content="Tag index - TweetFeed">
	<meta property="og:description" content="Index of all {{ tag_count }} tag landing pages: APT groups, malware families and TTPs.">
	<meta property="og:site_name" content="tweetfeed.live">
	<meta property="og:image" content="https://tweetfeed.live/img/TweetFeed_card_og.png">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="627">
	<meta property="og:image:type" content="image/png">
	<meta property="og:image:alt" content="TweetFeed - tag index">
	<link rel="preconnect" href="//fonts.googleapis.com">
	<link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" as="style" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></noscript>
	<link href="../css/sb-admin-2.min.css" rel="stylesheet">
	<link href="../css/table.css?v=4" rel="stylesheet">
	<link href="../css/index.css?v=48" rel="stylesheet">
	<link href="../css/tooltip.css" rel="stylesheet">
	<link href="../css/tweetfeed.css?v=48" rel="stylesheet">
	<link rel="preload" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@400;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@400;700;800&display=swap" rel="stylesheet"></noscript>
	<link rel="preload" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400..700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400..700&display=swap" rel="stylesheet"></noscript>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "TweetFeed",
		"url": "https://tweetfeed.live/",
		"logo": "https://tweetfeed.live/img/TweetFeed_card_og.png",
		"@id": "https://tweetfeed.live/#organization",
		"founder": {"@id": "https://tweetfeed.live/#founder"},
		"sameAs": [
			"https://github.com/0xDanielLopez/TweetFeed",
			"https://phishunt.io/",
			"https://daniel.tools/"
		]
	}
	</script>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": "Tag index",
		"url": "https://tweetfeed.live/tags/",
		"description": "Index of all {{ tag_count }} tag landing pages on TweetFeed.",
		"isPartOf": {"@id": "https://tweetfeed.live/#organization"},
		"inLanguage": "en",
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": {{ tag_count }},
			"itemListOrder": "https://schema.org/ItemListOrderAscending",
			"itemListElement": [{% for t in tags_flat %}
				{"@type": "ListItem", "position": {{ loop.index }}, "name": "#{{ t.display_tag }}", "url": "https://tweetfeed.live/tag/{{ t.slug }}/"}{% if not loop.last %},{% endif %}{% endfor %}
			]
		}
	}
	</script>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://tweetfeed.live/"},
			{"@type": "ListItem", "position": 2, "name": "Tag index", "item": "https://tweetfeed.live/tags/"}
		]
	}
	</script>
</head>

<body id="page-top">
	<a class="skip-link" href="#content">Skip to content</a>
	<style>
		.skip-link {
			position: absolute;
			top: -40px;
			left: 0;
			background: #000;
			color: #fff;
			padding: 8px 16px;
			z-index: 10000;
			text-decoration: none;
			font-family: 'Rubik', sans-serif;
			font-size: 14px;
			border-radius: 0 0 4px 0;
		}
		.skip-link:focus {
			top: 0;
			outline: 2px solid #3a6f96;
			outline-offset: -2px;
		}
	</style>
	<div id="wrapper">
		<div id="content-wrapper" class="d-flex flex-column">
{{ shell_nav }}
			<div id="content" tabindex="-1">
			<div class="docs-wrap">
{{ shell_docs_sidebar }}
				<main class="docs-content">
				<div id="presentationSecondary" class="d-none d-md-block">
					<br><br><br>
					<h1 class="toph1"><i class="fas fa-tags" style="font-size: 36px;"></i> Tag index</h1>
					<h2><em>{{ tag_count }} curated tag landing pages: APT groups, malware families and TTPs</em></h2>
				</div>
				<div id="presentationMobile" class="d-block d-md-none">
					<br>
					<p class="toph1" role="heading" aria-level="1"><i class="fas fa-tags" style="font-size: 36px;"></i> Tag index</p>
					<p style="font-size: 14px;"><em>{{ tag_count }} curated tag landing pages</em></p>
				</div>
				<hr class="divider">

				{% for cat in categories %}
				<h3 class="section-heading">{{ cat.heading }} <span style="font-size:14px; color:#737373; font-weight:400;">&middot; {{ cat.tags | length }}</span></h3>
				<div class="card mb-4">
					<div class="card-body">
						<p style="margin-bottom:0.9rem; color:#737373; font-size:14px; font-family:'Rubik',sans-serif;">{{ cat.blurb }}</p>
						<div class="row">
							{% for t in cat.tags %}
							<div class="col-md-6 col-12" style="margin-bottom:0.7rem;">
								<a href="../tag/{{ t.slug }}/" class="text-decoration-none" style="display:block; padding:0.5rem 0.7rem; border:1px solid #1c1c1c; border-radius:0; background:#fff;">
									<div style="display:flex; justify-content:space-between; align-items:baseline; gap:0.6rem;">
										<span style="font-family:'Rubik',sans-serif; font-weight:600; color:#1c1c1c;">#{{ t.display_tag }}</span>
										<span style="font-size:11px; color:#737373; font-family:'Rubik',sans-serif; white-space:nowrap;">{{ t.year_count }} hits last year &middot; {{ t.month_count }} last month</span>
									</div>
									<div style="font-size:12px; color:#737373; font-family:'Rubik',sans-serif; line-height:1.4; margin-top:0.15rem;">{{ t.subtitle }}</div>
								</a>
							</div>
							{% endfor %}
						</div>
					</div>
				</div>
				{% endfor %}

				<h3 class="section-heading">Other reference</h3>
				<div class="card mb-4">
					<div class="card-body">
						<p style="margin-bottom:0; color:#1c1c1c; font-size:15px; font-family:'Rubik',sans-serif; line-height:1.7;">
							<a href="../ioc-types/" class="text-decoration-none"><b>IOC types</b></a> &middot; the 5 type-specific hubs (URLs / domains / IPs / MD5 / SHA-256). <br>
							<a href="../threat-intelligence-guide/" class="text-decoration-none"><b>Threat Intelligence guide</b></a> &middot; ~1,640-word pillar covering IOC types, OSINT vs commercial, MITRE ATT&amp;CK basics, glossary.
						</p>
					</div>
				</div>
				</main>

			</div>
			</div>
{{ shell_footer }}
		</div>
	</div>
	<script src="../vendor/jquery/jquery.min.js"></script>
	<script src="../vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="../vendor/jquery-easing/jquery.easing.min.js"></script>
	<script src="../js/sb-admin-2.min.js"></script>
	<script src="../js/utils.js?v=4"></script>
</body>

</html>
